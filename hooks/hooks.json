{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|ExitPlanMode)$",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/elonify-hook.mjs"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "elonify-critic",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/elonify-hook.mjs"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/elonify-hook.mjs"], "timeout": 10 }
        ]
      }
    ]
  }
}
